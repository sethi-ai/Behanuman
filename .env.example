# Copy to .env.local for your own isolated Convex development project.
NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
# Optional CLI target for your OWN project, not the maintainer deployment.
CONVEX_DEPLOYMENT=dev:YOUR_DEPLOYMENT
# Server-only Convex variables are configured on your backend, never here:
# AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, SITE_URL, JWT_PRIVATE_KEY, JWKS
# Optional Claude: ANTHROPIC_API_KEY, HI_PROVIDER, HI_MODEL, HI_MODE, HI_ENABLED
# Keep HI_ENABLED=false until source and rights review plus provider checks pass.
